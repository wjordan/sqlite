  do_test index-vcov-2.1 {
    execsql {
      CREATE TABLE t_gen_std (
        id INTEGER PRIMARY KEY,
        data TEXT,
        gen_virt AS (id || ':' || upper(data)) VIRTUAL
      );
      INSERT INTO t_gen_std(id, data) VALUES (1, 'one'), (2, 'two'), (3, 'three');

      CREATE INDEX idx_gen_virt_vc_std ON t_gen_std(gen_virt);
      CREATE INDEX idx_gen_virt_vc_data_std ON t_gen_std(gen_virt, data);
      CREATE INDEX idx_gen_virt_id_vc_std ON t_gen_std(id, gen_virt);
    }
  } {}

  # EQP Tests for t_gen_std
  do_eqp_test index-vcov-2.2 {
    SELECT gen_virt FROM t_gen_std INDEXED BY idx_gen_virt_vc_std WHERE gen_virt = '2:TWO';
