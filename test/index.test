# Additional test for WITHOUT ROWID table where PK is part of the generated column.
# And index is on the generated column only.
# Query selects only the generated column, but filters on PK.
ifcapable {generated_columns && without_rowid} {
  do_test index-vcov-6.1 {
    execsql {
      CREATE TABLE t_gen_wr2 (
        id INTEGER,
        data TEXT,
        id2 INTEGER,
        gen_virt AS (id || ':' || upper(data) || ':' || id2) VIRTUAL,
        PRIMARY KEY(id, id2)
      ) WITHOUT ROWID;
      INSERT INTO t_gen_wr2(id, data, id2) VALUES (1, 'one', 101), (2, 'two', 202), (3, 'three', 303);
      CREATE INDEX idx_gen_virt_vc_wr2 ON t_gen_wr2(gen_virt);
    }
  } {}

  # EQP: Select gen_virt, filter by id. idx_gen_virt_vc_wr2 contains gen_virt.
  # The expression for gen_virt contains 'id'.
  # Since 'id' is part of PK for WITHOUT ROWID, it's implicitly available to covering index checks.
  # The planner should realize idx_gen_virt_vc_wr2 can be covering if gen_virt is the only thing selected.
  # The WHERE clause on 'id' is the tricky part.
  # If 'id' can be satisfied by the index for the WHERE clause, then it's covering.
  # However, idx_gen_virt_vc_wr2 is *only* on gen_virt.
  # This will likely require a PK lookup (which is the table itself for WR) for the WHERE clause,
  # and then the gen_virt can be computed or fetched.
  # If the optimization works, gen_virt is fetched from the index, after PK lookup.
  # The EQP might show "SEARCH ... USING INDEX ... (id=?)" if it uses the PK,
  # or "SCAN ... USING COVERING INDEX" if it somehow uses the gen_virt index to satisfy `id` (less likely).
  # Let's test selecting only gen_virt and filtering by gen_virt.
  do_eqp_test index-vcov-6.2 {
    SELECT gen_virt FROM t_gen_wr2 INDEXED BY idx_gen_virt_vc_wr2 WHERE gen_virt = '2:TWO:202';
  } {/SEARCH t_gen_wr2 USING COVERING INDEX idx_gen_virt_vc_wr2/}

  # Now, the more complex case: select gen_virt, filter by id.
  # If the generated column's own definition (id || ':' || upper(data) || ':' || id2)
  # is part of the idx_gen_virt_vc_wr2 (which it is, as it's the indexed column),
  # and the query only selects gen_virt, it should be covering.
  # The WHERE id=2 part: for WITHOUT ROWID, id is part of PK.
  # The query plan should be "SEARCH ... USING PRIMARY KEY ... then compute/filter gen_virt"
  # OR "SCAN ... USING COVERING INDEX idx_gen_virt_vc_wr2 ... then filter gen_virt and id (if id also in gen_virt)"
  #
  # The key is whether the value of `gen_virt` is read from the index `idx_gen_virt_vc_wr2`
  # or recomputed after a PK lookup.
  # If the previous change (sqlite3ExprCodeGetColumnOfTable) works,
  # after a PK lookup for `id=2`, when `gen_virt` is needed, it should be
  # recognized as being available in `idx_gen_virt_vc_wr2` if that index is also being used.
  # But here we are *forcing* idx_gen_virt_vc_wr2.
  # This index does not help with `WHERE id=2`. So it's a SCAN.
  # Once a row is found, `gen_virt` is needed. It should come from the index.
  do_eqp_test index-vcov-6.3 {
    SELECT gen_virt FROM t_gen_wr2 INDEXED BY idx_gen_virt_vc_wr2 WHERE id = 2;
  } {/SCAN t_gen_wr2 USING COVERING INDEX idx_gen_virt_vc_wr2/}

  do_test index-vcov-6.4 {
    execsql { SELECT gen_virt FROM t_gen_wr2 INDEXED BY idx_gen_virt_vc_wr2 WHERE id = 2; }
  } {2:TWO:202}

  # Test with an index on (id, gen_virt) for WR table
  do_test index-vcov-6.5 {
    execsql { CREATE INDEX idx_id_gen_virt_wr2 ON t_gen_wr2(id, gen_virt); }
  } {}

  do_eqp_test index-vcov-6.6 {
    SELECT id, gen_virt FROM t_gen_wr2 INDEXED BY idx_id_gen_virt_wr2 WHERE id = 1;
  } {/SEARCH t_gen_wr2 USING COVERING INDEX idx_id_gen_virt_wr2/}

  do_test index-vcov-6.7 {
    execsql { SELECT id, gen_virt FROM t_gen_wr2 INDEXED BY idx_id_gen_virt_wr2 WHERE id = 1; }
  } {{1 1:ONE:101}}

}


finish_test
