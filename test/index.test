  } {/SEARCH t_gen_std USING COVERING INDEX idx_gen_virt_id_vc_std/}

  do_eqp_test index-vcov-2.4 {
    SELECT data, gen_virt FROM t_gen_std INDEXED BY idx_gen_virt_vc_data_std WHERE data = 'two';
  } {/SEARCH t_gen_std USING COVERING INDEX idx_gen_virt_vc_data_std/}
  
  # This should NOT be covering for 'data'
  do_eqp_test index-vcov-2.5 {
    SELECT id, data, gen_virt FROM t_gen_std INDEXED BY idx_gen_virt_id_vc_std WHERE id = 1;
  } {/SEARCH t_gen_std USING INDEX idx_gen_virt_id_vc_std/}
  # Verify the above EQP does not say COVERING
  do_eqp_test index-vcov-2.5.notcovering {
    SELECT id, data, gen_virt FROM t_gen_std INDEXED BY idx_gen_virt_id_vc_std WHERE id = 1;
  } {/(?!COVERING)SEARCH t_gen_std USING INDEX idx_gen_virt_id_vc_std/}

  # Result Correctness Tests for t_gen_std
  do_test index-vcov-2.6 {
    execsql {
      SELECT gen_virt FROM t_gen_std INDEXED BY idx_gen_virt_vc_std WHERE gen_virt = '2:TWO';
    }
  } {{2:TWO}}

  do_test index-vcov-2.7 {
    execsql {
      SELECT id, gen_virt FROM t_gen_std INDEXED BY idx_gen_virt_id_vc_std WHERE id = 2;
    }
  } {{2 2:TWO}}

  do_test index-vcov-2.8 {
    execsql {
      SELECT data, gen_virt FROM t_gen_std INDEXED BY idx_gen_virt_vc_data_std WHERE data = 'two';
    }
  } {{two 2:TWO}}

  do_test index-vcov-2.9 {
    execsql {
      SELECT id, data, gen_virt FROM t_gen_std INDEXED BY idx_gen_virt_id_vc_std WHERE id = 1;
    }
  } {{1 one 1:ONE}}
  
  do_test index-vcov-2.10 {
    execsql {
      SELECT id, gen_virt FROM t_gen_std INDEXED BY idx_gen_virt_vc_std WHERE id = 3;
    }
  } {{3 3:THREE}}
}

# Tests for complex generated expressions (e.g., using functions)
ifcapable generated_columns {
  do_test index-vcov-3.1 {
    execsql {
      CREATE TABLE t_gen_func (
        id INTEGER PRIMARY KEY,
        data TEXT,
        gen_len AS (length(data)) VIRTUAL
      );
      INSERT INTO t_gen_func(id, data) VALUES (1, 'abc'), (2, 'defg'), (3, 'hijkl');
      CREATE INDEX idx_gen_len ON t_gen_func(gen_len);
    }
  } {}

  do_eqp_test index-vcov-3.2 {
    SELECT gen_len FROM t_gen_func INDEXED BY idx_gen_len WHERE gen_len = 4;
  } {/SEARCH t_gen_func USING COVERING INDEX idx_gen_len/}

  do_test index-vcov-3.3 {
    execsql {
      SELECT gen_len FROM t_gen_func INDEXED BY idx_gen_len WHERE gen_len = 4 ORDER BY id;
    }
  } {4}
  
  do_test index-vcov-3.4 {
    execsql {
      SELECT id, gen_len FROM t_gen_func INDEXED BY idx_gen_len WHERE data = 'abc'; -- data not in index
    }
  } {{1 3}}
}

# Tests for generated column not in index
ifcapable {generated_columns && without_rowid} {
  do_test index-vcov-4.1 {
    execsql {
      CREATE TABLE t_gen_other_wr (
        id INTEGER PRIMARY KEY,
        data TEXT,
        gen1 AS (id+length(data)) VIRTUAL,
        gen2 AS (id*length(data)) VIRTUAL
      ) WITHOUT ROWID;
      INSERT INTO t_gen_other_wr(id, data) VALUES (1, 'a'), (2, 'bb'), (3, 'ccc');
      CREATE INDEX idx_gen_other_1_wr ON t_gen_other_wr(gen1);
    }
  } {}

  # gen1 from index, gen2 requires computation/table access
  do_eqp_test index-vcov-4.2 {
    SELECT gen1, gen2 FROM t_gen_other_wr INDEXED BY idx_gen_other_1_wr WHERE id = 2;
  } {/SEARCH t_gen_other_wr USING INDEX idx_gen_other_1_wr/}
  # Verify the above EQP does not say COVERING
  do_eqp_test index-vcov-4.2.notcovering {
    SELECT gen1, gen2 FROM t_gen_other_wr INDEXED BY idx_gen_other_1_wr WHERE id = 2;
  } {/(?!COVERING)SEARCH t_gen_other_wr USING INDEX idx_gen_other_1_wr/}


  do_test index-vcov-4.3 {
    execsql {
      SELECT gen1, gen2 FROM t_gen_other_wr INDEXED BY idx_gen_other_1_wr WHERE id = 2;
    }
  } {{4 4}}

  do_test index-vcov-4.4 {
    execsql {
      SELECT gen1 FROM t_gen_other_wr INDEXED BY idx_gen_other_1_wr WHERE gen1 = 4;
    }
  } {4}
  
  do_eqp_test index-vcov-4.5 {
     SELECT gen1 FROM t_gen_other_wr INDEXED BY idx_gen_other_1_wr WHERE gen1 = 4;
  } {/SEARCH t_gen_other_wr USING COVERING INDEX idx_gen_other_1_wr/}

}

